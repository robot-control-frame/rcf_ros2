{
  // 保存时按仓库里的配置格式化：C++ 用 .clang-format，Python 用 .ruff.toml。
  // CMake 故意不在这里自动格式化：gersemi 没有 VS Code 扩展，
  // 一旦装了 cmake-format 扩展，保存时会把 gersemi 的排版改回去。
  // CMake 请在提交前跑 scripts/format.sh，或者用任务面板里的 “format: cmake”。
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.clang_format_fallbackStyle": "none",
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },

  "[cmake]": {
    "editor.formatOnSave": false
  },

  // 别让编辑器把 .clang-format / .gersemirc / .ruff.toml 当成普通文件重排
  "[ignore]": {
    "editor.formatOnSave": false
  }
}
